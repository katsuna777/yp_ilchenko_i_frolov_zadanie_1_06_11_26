<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>../../resources/Чудо Обувь.ico</ApplicationIcon>
    <AssemblyName>ChudoObuv</AssemblyName>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="MySqlConnector" Version="2.6.2" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../resources/Images/*.png" Link="Images/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/Чудо Обувь.png" Link="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/Чудо Обувь.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="*.resx"><DependentUpon>%(Filename).cs</DependentUpon></EmbeddedResource>
  </ItemGroup>
</Project>
